# Copy to .env for local development. Never commit a real .env file.

# Set to "true" to enable the "Load bundled sample data" button on the Home
# page (development only -- must default off in production). On Streamlit
# Community Cloud, set this via the app's Secrets instead of an .env file:
# dev_mode = true   (in .streamlit/secrets.toml or the Cloud Secrets UI)
LINDA_DEV_MODE=false
